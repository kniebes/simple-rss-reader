# Copy to .env (which is gitignored) and fill in your API key.
ANTHROPIC_API_KEY=

# Default values match the DDEV MariaDB defaults (host `db`, user/pass/dbname
# `db`). Override only if you run against another MySQL/MariaDB instance.
DATABASE_URL="mysql://db:db@db:3306/db"

# Cookie-Login (ersetzt Basic Auth). Beide Werte sind Pflicht, sonst kommt
# niemand rein (fail closed). Der Passwort-Hash wird base64-kodiert abgelegt,
# damit das `$` im bcrypt-Hash nicht von Dotenv expandiert wird - so ist das
# Quoting egal.
#   Hash (base64):  php -r 'echo base64_encode(password_hash("DEINPASSWORT", PASSWORD_DEFAULT)), "\n";'
#   Secret:         php -r 'echo bin2hex(random_bytes(32)), "\n";'
AUTH_PASSWORD_HASH=
AUTH_SECRET=
# Optional: Cookie-Lebensdauer in Sekunden (Default 31536000 = 1 Jahr).
#AUTH_COOKIE_LIFETIME=31536000
